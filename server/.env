# SERVER
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000

# JWT
JWT_SECRET=ndryshoje-me-string-te-gjate-random-32-karaktere-minimum
JWT_EXPIRES_IN=7d

# DATABASE
DB_PATH=./data/taxiapp.db

# EMAIL (për OTP — më vonë)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=taxiapp@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=TaxiApp <taxiapp@gmail.com>

# TENANT
DEFAULT_TENANT=default
ALLOW_REGISTRATION=false

# ADMIN I PARË (auto-krijohet)
FIRST_ADMIN_USERNAME=G
FIRST_ADMIN_PASSWORD=1
FIRST_ADMIN_NAME=Granit Gashi
